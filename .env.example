# Realtime communication
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=saarthi
LIVEKIT_TOKEN_TTL_SECONDS=900

# Speech recognition and synthesis
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
RESPONSE_USER_IDLE_TIMEOUT_SECONDS=1.50
INTERRUPTED_RESPONSE_RECOVERY_DELAY_SECONDS=1.75
INTERRUPTED_RESPONSE_MAX_RETRIES=1
RIME_API_KEY=
RIME_MODEL=mistv2
RIME_SPEAKER=astra
RIME_SAMPLE_RATE=24000

# Language model
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=12
GROQ_TEMPERATURE=0
GEMINI_API_KEY=

# Product-knowledge retrieval
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=loan_product_facts
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_LIMIT=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# Local application services
DATABASE_URL=sqlite+aiosqlite:///./data/saarthi.db
REDIS_URL=

# Local server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
